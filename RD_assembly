### Step 3: parameter optimisation using RADstackhelpR
## 3.1 examine the properties of the sample-level datasets (.tsv) and select a panel of samples (n = 20) suitable for use in STACKS parameter optimization (m; M, n) for the _de novo_ RAD loci assembly strategy
# ~equal representation between sampling locations as well as close to average reads

## m [radstackhelpT_optim_m.sh]
module load app/stacks/2.59
# work directory as new folders will be created from here
WORK=/new-home/mjgroeneveld/radseq/RD_assembly_A/optim/
# fastq read files
READS_DIR=/new-home/mjgroeneveld/radseq/RD_demultiplex_A/reads/
# popmap file
POPMAP=/new-home/mjgroeneveld/radseq/RD_assembly_A/optim/popmap_optim.txt

for m in {3..7}; do

  OUT=$WORK/denovo.m${m}
  mkdir -p $OUT

  echo "Running m=$m"

  /apps/stacks/2.59/bin/denovo_map.pl \
    --samples $READS_DIR \
    --popmap $POPMAP \
    --out-path $OUT \
    --paired \
    -m $m \
    -T 12 \
    -X "populations: --vcf" \
    > $OUT/denovo_map.log 2>&1

done

