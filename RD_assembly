/apps/stacks/2.59/bin/process_radtags \
  -1 $datadir/Rdji-3RAD-D2-Plate10_L001_R1_001.fastq.gz \
  -2 $datadir/Rdji-3RAD-D2-Plate10_L001_R2_001.fastq.gz \
  -i gzfastq \
  -b $datadir2/intags_d2_RD.txt --inline_inline \
